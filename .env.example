API_PORT=5050
NODE_ENV=development
# MongoDB connection string, including the database name
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
# Long random string used to sign login tokens
JWT_SECRET=change-me
# Shared code a new team member must enter to sign up
TEAM_SIGNUP_CODE=change-me
# Timezone used for "today" and "this week"
APP_TIMEZONE=Asia/Kolkata
# Number of reverse proxies in front of the app (0 when none)
TRUST_PROXY=0
